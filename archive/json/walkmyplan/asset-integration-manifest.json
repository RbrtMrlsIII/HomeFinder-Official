    "tier0": "poster/static 2D fallback",
    "tier1": "mobile-safe optimized GLB/GLTF",
    "tier2": "standard desktop optimized GLB/GLTF",
    "tier3": "high-fidelity optional desktop asset",
    "formats": [
      "glb",
      "gltf",
      "webp",
      "avif",
      "ktx2"
    ],
    "video_policy": "video is optional and never the default payload",
    "raw_master_policy": "raw 4K masters remain outside runtime delivery",
    "compression": "required before production runtime",
    "lod": "required for Tier 2/3 where geometry warrants it",
    "texture_budget": "use compressed textures; no unbounded 4K texture sets",
    "animation": "short deterministic loops; pause when hidden/offscreen"
  },
  "load_graph": [
    "global-house-shell",
    "current-room-shell",
    "current-hero",
    "next-likely-room",
    "secondary-objects-on-demand"
  ],
  "failure_contract": [
    "route continues",
    "HTML UI remains usable",
    "fallback appears",
    "no infinite loader"
  ],
  "source_metadata_required": [
    "provider",
    "source_url_or_internal_id",
    "license",
    "attribution_if_required",
    "creation_date",
    "optimization_toolchain",
    "checksum_sha256"
