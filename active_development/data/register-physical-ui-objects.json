      "pov": "R-04",
      "purpose": "account type decision",
      "responsive": "auth-choice",
      "animation": "emphasis"
    },
    {
      "id": "register-contact-station",
      "label": "Register Contact Station",
      "selector": "#register-form .field-group:nth-of-type(1)",
      "kind": "auth-field-group",
      "pov": "R-02",
      "purpose": "email/contact entry",
      "responsive": "auth-field",
      "animation": "state"
    },
    {
      "id": "register-password-station",
      "label": "Register Password Station",
      "selector": "#register-form .field-group:nth-of-type(2)",
      "kind": "auth-field-group",
      "pov": "R-05",
      "purpose": "password entry",
      "responsive": "auth-field",
      "animation": "state"
    },
    {
      "id": "register-confirmation-station",
      "label": "Register Confirmation Station",
      "selector": "#register-form .field-group:nth-of-type(3)",
      "kind": "auth-field-group",
      "pov": "R-05",
      "purpose": "password confirmation",
      "responsive": "auth-field",
      "animation": "state"
    },
    {
      "id": "register-submit-console",
      "label": "Register Submit Console",
