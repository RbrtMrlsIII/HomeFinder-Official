    "success",
    "error",
    "empty",
    "disabled"
  ],
  "stateMachineContract": {
    "states": [
      "idle",
      "hover",
      "focus",
      "interaction-start",
      "ui-open",
      "loading",
      "success",
      "error",
      "empty",
      "disabled"
    ],
    "events": [
      "hover",
      "unhover",
      "focus",
      "blur",
      "activate",
      "open",
      "loading",
      "success",
      "error",
      "empty",
      "disable",
      "enable",
      "reset"
    ],
    "invalidTransitionPolicy": "retain-current-state",
    "authority": "presentation-only"
  },
  "responsiveRootContract": {
    "mobile-portrait": {
      "touchMin": "44px",
      "layout": "stack",
      "motion": "micro",
      "cameraSafeArea": "center-safe"
    },
    "mobile-landscape": {
      "touchMin": "44px",
      "layout": "compact-row",
      "motion": "micro",
      "cameraSafeArea": "center-safe"
    },
    "compact": {
      "touchMin": "44px",
      "layout": "adaptive",
      "motion": "state",
      "cameraSafeArea": "content-safe"
    },
    "tablet": {
      "touchMin": "44px",
      "layout": "adaptive-grid",
      "motion": "state",
      "cameraSafeArea": "content-safe"
    },
    "desktop": {
      "touchMin": "44px",
      "layout": "full-composition",
      "motion": "state",
      "cameraSafeArea": "full"
    },
    "wide-desktop": {
      "touchMin": "44px",
      "layout": "capped-composition",
      "motion": "emphasis",
      "cameraSafeArea": "full"
    }
  }
